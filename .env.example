# Somente desenvolvimento local. Não use estas credenciais em produção.
POSTGRES_DB=finance
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
FINANCE_API_PORT=8000
FINANCE_WEB_PORT=5173

FINANCE_ENVIRONMENT=local
FINANCE_DATABASE_URL=postgresql+psycopg://finance_app:local-development-only@db:5432/finance
FINANCE_TIMEZONE=America/Campo_Grande
FINANCE_LOG_LEVEL=INFO
FINANCE_DB_CONNECT_ATTEMPTS=20
FINANCE_DB_CONNECT_DELAY_SECONDS=2
FINANCE_CSV_UPLOAD_MAX_BYTES=10485760
FINANCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram permanece inativo até o usuário configurar o próprio bot.
FINANCE_TELEGRAM_ENABLED=false
FINANCE_TELEGRAM_BOT_TOKEN=token-ficticio-do-bot
FINANCE_TELEGRAM_CHAT_ID=000000000
FINANCE_TELEGRAM_POLL_SECONDS=20
FINANCE_TELEGRAM_SCAN_SECONDS=15
FINANCE_TELEGRAM_MAX_ATTEMPTS=3

# Pluggy permanece inativa. Use somente credenciais de sandbox/desenvolvimento aqui.
FINANCE_PLUGGY_ENABLED=false
FINANCE_PLUGGY_CLIENT_ID=00000000-0000-0000-0000-000000000000
FINANCE_PLUGGY_CLIENT_SECRET=segredo-ficticio-da-pluggy
FINANCE_PLUGGY_API_BASE_URL=https://api.pluggy.ai
FINANCE_PLUGGY_CLIENT_USER_ID=finance-system-personal
FINANCE_PLUGGY_CONNECTOR_ID=200
FINANCE_PLUGGY_INCLUDE_SANDBOX=true
FINANCE_PLUGGY_POLL_SECONDS=900
FINANCE_PLUGGY_FULL_SYNC_SECONDS=86400
FINANCE_PLUGGY_WORKER_SCAN_SECONDS=15
FINANCE_PLUGGY_MAX_ATTEMPTS=5
