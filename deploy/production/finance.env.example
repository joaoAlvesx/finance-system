# Copie para /opt/homelab/finance/finance.env com modo 600.
# Valores abaixo são fictícios. Não grave segredos no repositório.
FINANCE_ENVIRONMENT=production
FINANCE_DATABASE_URL=postgresql+psycopg://finance_app:SENHA_HEXADECIMAL_GERADA@postgres:5432/finance
FINANCE_TIMEZONE=America/Campo_Grande
FINANCE_LOG_LEVEL=INFO
FINANCE_DB_CONNECT_ATTEMPTS=60
FINANCE_DB_CONNECT_DELAY_SECONDS=2
FINANCE_CSV_UPLOAD_MAX_BYTES=10485760
FINANCE_CORS_ORIGINS=https://finance.example.com

# Usada apenas pelo script create-finance-database.sh. Deve ser a mesma senha da URL.
FINANCE_DB_PASSWORD=SENHA_HEXADECIMAL_GERADA

FINANCE_TELEGRAM_ENABLED=true
FINANCE_TELEGRAM_BOT_TOKEN=TOKEN_FICTICIO_DO_BOT
FINANCE_TELEGRAM_CHAT_ID=000000000
FINANCE_TELEGRAM_POLL_SECONDS=20
FINANCE_TELEGRAM_SCAN_SECONDS=15
FINANCE_TELEGRAM_MAX_ATTEMPTS=3

FINANCE_PLUGGY_ENABLED=true
FINANCE_PLUGGY_CLIENT_ID=00000000-0000-0000-0000-000000000000
FINANCE_PLUGGY_CLIENT_SECRET=SEGREDO_FICTICIO_DA_PLUGGY
FINANCE_PLUGGY_API_BASE_URL=https://api.pluggy.ai
FINANCE_PLUGGY_CLIENT_USER_ID=finance-system-personal
FINANCE_PLUGGY_CONNECTOR_ID=200
FINANCE_PLUGGY_INCLUDE_SANDBOX=false
FINANCE_PLUGGY_POLL_SECONDS=900
FINANCE_PLUGGY_FULL_SYNC_SECONDS=86400
FINANCE_PLUGGY_WORKER_SCAN_SECONDS=15
FINANCE_PLUGGY_MAX_ATTEMPTS=5
