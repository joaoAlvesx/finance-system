# Configuração para executar este projeto somente no computador local.
# Copie este arquivo para .env na mesma pasta de docker-compose.yml.
# Estes valores são fictícios. Troque a senha antes da primeira inicialização.

POSTGRES_DB=finance
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=senha_ficticia_local_123
POSTGRES_PORT=5432

FINANCE_API_PORT=8000
FINANCE_WEB_PORT=5173
FINANCE_ENVIRONMENT=local
FINANCE_TIMEZONE=America/Campo_Grande

# Integrações opcionais desativadas. Não são necessárias para uso local.
FINANCE_TELEGRAM_ENABLED=false
FINANCE_PLUGGY_ENABLED=false
